# FantaBlitz — variabili d'ambiente.
#
# Copiare questo file in `.env` NELLA RADICE del progetto e riempirlo.
# Un solo file per tutto: il sito e i job leggono lo stesso.
# `.env` e' in .gitignore: nessun valore reale va mai committato.

# --- Supabase --------------------------------------------------------
#
# Dal pannello del progetto, Project Settings -> API (o "API Keys").
# A seconda di quando e' stato creato il progetto le chiavi si chiamano
# `anon` e `service_role`, oppure `publishable` (sb_publishable_...) e
# `secret` (sb_secret_...). Sono le stesse due cose con nomi diversi:
# la prima e' pubblica, la seconda no.

# L'indirizzo del progetto, del tipo https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chiave PUBBLICA (anon / publishable). Finisce nel browser ed e' giusto
# cosi': da sola non da' accesso a niente, perche' a proteggere i dati
# sono le regole RLS sul database.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave SEGRETA (service_role / secret). Scavalca le regole RLS.
# Non deve MAI finire nel browser: niente prefisso NEXT_PUBLIC_, e non
# va usata in nessun file dentro app/ che non sia lato server.
# La usa il job serale, che lavora per conto della lega e non di una
# persona.
SUPABASE_SERVICE_ROLE_KEY=

# --- Amministrazione --------------------------------------------------
#
# La mail di chi può creare leghe, importare rose e assegnare le squadre
# dall'area /admin del sito. Una sola mail: con dieci amici e una lega alla
# volta non serve un ruolo per lega. Senza questa variabile /admin resta
# inaccessibile (nega di default), non aperta a chiunque.
ADMIN_EMAIL=

# --- Job serale ------------------------------------------------------
#
# Protegge l'endpoint che fa girare la giornata: senza, chiunque
# conoscesse l'indirizzo potrebbe far giocare la lega quando gli pare.
# Generala a caso, non sceglierla:
#
#   openssl rand -hex 32
#
CRON_SECRET=

# --- Strato AI (milestone 7) -----------------------------------------
#
# Dalla console Groq (console.groq.com/keys). Piano gratuito: circa 15
# chiamate al giorno per lega, ampiamente dentro i limiti. Senza questa
# variabile i generatori usano il fallback da template: la giornata si
# gioca lo stesso, solo senza testo generato.
GROQ_API_KEY=

# --- Archivio su file (solo in locale) -------------------------------
#
# Dove tenere le leghe quando si lavora senza database. In produzione
# non si usa: il filesystem di Vercel e' effimero.
# FANTABLITZ_ARCHIVIO=
