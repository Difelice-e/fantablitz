{
  "name": "fantablitz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "engine",
    "fanta",
    "jobs",
    "seed",
    "web"
  ],
  "scripts": {
    "seed": "npm run seed --workspace seed",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "calibra": "npm run calibra --workspace engine",
    "importa": "npm run importa --workspace jobs",
    "ciclo": "npm run ciclo --workspace jobs",
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "crea-lega": "npm run crea-lega --workspace jobs",
    "gioca": "npm run gioca --workspace jobs",
    "assegna-squadra": "npm run assegna-squadra --workspace jobs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
